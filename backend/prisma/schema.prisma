datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SensorLog {
  id          String   @id @default(uuid())
  deviceId    String   @default("pie-node-01")
  co2         Float
  temperature Float
  humidity    Float
  moisture    Float
  light       Float
  timestamp   DateTime @default(now())

  @@index([timestamp])
}
